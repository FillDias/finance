<% content_for :title, "Investimentos" %>
<div class="page-header">
  <h1>Investimentos</h1>
</div>

<section>
  <h2>Total investido</h2>
  <div class="kpi">
    <div class="kpi-valor"><%= moeda(@total_investido) %></div>
    <div class="sparkline" data-controller="chart" data-chart-option-value="<%= @grafico_sparkline_total.to_json %>"></div>
  </div>
</section>

<section class="grid-graficos">
  <div>
    <h2>Evolução dos aportes</h2>
    <div class="grafico" data-controller="chart" data-chart-option-value="<%= @grafico_evolucao_aportes.to_json %>"></div>
  </div>
  <div>
    <h2>Distribuição por tipo</h2>
    <div class="grafico" data-controller="chart" data-chart-option-value="<%= @grafico_distribuicao_por_tipo.to_json %>"></div>
  </div>
</section>

<section>
  <h2>Taxa CDI</h2>
  <%= form_with model: @taxa_cdi, url: taxa_cdi_path, scope: :taxa_cdi, method: :patch, local: true, class: "formulario-inline" do |f| %>
    <%= f.label :valor, "% ao ano" %>
    <%= f.number_field :valor, step: "0.001", min: "0", value: @taxa_cdi.valor, required: true %>
    <%= f.submit "Salvar" %>
  <% end %>

  <% if @comparacoes_cdi.any? %>
    <ul class="lista-comparacao-cdi">
      <% @comparacoes_cdi.each do |comparacao| %>
        <li>
          <%= comparacao.investimento.instituicao %>:
          <%= number_with_precision(comparacao.taxa_anualizada, precision: 3) %>% a.a.
          <span class="<%= comparacao.acima_do_cdi? ? "cor-positiva" : "cor-negativa" %>">
            (<%= comparacao.acima_do_cdi? ? "acima" : "abaixo" %> do CDI em <%= number_with_precision(comparacao.diferenca.abs, precision: 3) %> p.p.)
          </span>
        </li>
      <% end %>
    </ul>
  <% elsif @taxa_cdi.valor.positive? %>
    <p class="ajuda">Nenhum investimento do tipo "CDI" cadastrado ainda para comparar.</p>
  <% end %>
</section>

<section class="formulario-secao">
  <h2>Novo investimento</h2>
  <%= render "form", investimento: @investimento, tipos_investimento: @tipos_investimento %>
  <p class="ajuda"><%= link_to "Gerenciar tipos de investimento", tipos_investimento_path %></p>
</section>

<section>
  <h2>Investimentos cadastrados</h2>
  <% if @investimentos.empty? %>
    <p class="vazio">Nenhum investimento cadastrado ainda.</p>
  <% else %>
    <table class="tabela-densa">
      <thead>
        <tr>
          <th>Instituição</th>
          <th>Tipo</th>
          <th>Taxa</th>
          <th>Vencimento</th>
          <th>Situação</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @investimentos.each do |investimento| %>
          <tr>
            <td><%= link_to investimento.instituicao, investimento_path(investimento) %></td>
            <td><%= investimento.tipo_investimento.nome %></td>
            <td><%= taxa_rendimento(investimento) %></td>
            <td><%= investimento.data_vencimento&.strftime("%d/%m/%Y") || "—" %></td>
            <% if investimento.resgatado? %>
              <td>Resgatado em <%= investimento.data_resgate.strftime("%d/%m/%Y") %> (<%= moeda(investimento.valor_resgatado) %>)</td>
              <td class="acoes"><%= link_to "Editar", edit_investimento_path(investimento) %></td>
            <% else %>
              <td><%= investimento.status_label %></td>
              <td class="acoes">
                <%= link_to "Editar", edit_investimento_path(investimento) %>
                <%= form_with url: resgatar_investimento_path(investimento), scope: :investimento, method: :patch, local: true, class: "formulario-inline" do |f| %>
                  <%= f.number_field :valor_resgatado, step: "0.01", min: "0.01", placeholder: "Valor resgatado", required: true %>
                  <%= f.date_field :data_resgate, required: true %>
                  <%= f.submit "Resgatar" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
