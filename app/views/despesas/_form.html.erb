<%= form_with model: despesa, url: (despesa.persisted? ? despesa_path(despesa) : despesas_path), local: true, class: "formulario" do |f| %>
  <% if despesa.errors.any? %>
    <div class="form-erros">
      <ul>
        <% despesa.errors.full_messages.each do |mensagem| %>
          <li><%= mensagem %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="campo">
    <%= f.label :valor, "Valor" %>
    <%= f.number_field :valor, step: "0.01", min: "0.01", required: true %>
  </div>

  <div class="campo">
    <%= f.label :data, "Data" %>
    <%= f.date_field :data, required: true %>
  </div>

  <div class="campo">
    <%= f.label :categoria_id, "Categoria" %>
    <%= f.collection_select :categoria_id, categorias, :id, :nome, prompt: "Selecione" %>
  </div>

  <div class="campo">
    <%= f.label :tipo, "Tipo" %>
    <%= f.select :tipo, Despesa::TIPO_LABEL.map { |valor, rotulo| [ rotulo, valor ] }, prompt: "Selecione" %>
  </div>

  <div class="campo">
    <%= f.label :forma_pagamento, "Forma de pagamento" %>
    <% opcoes_forma_pagamento = Despesa::FORMA_PAGAMENTO_LABEL.map { |valor, rotulo| [ rotulo, valor ] } %>
    <% opcoes_forma_pagamento += [ [ "Cartão", Despesa::FORMA_PAGAMENTO_CARTAO ] ] if permitir_cartao %>
    <%= f.select :forma_pagamento, opcoes_forma_pagamento, prompt: "Selecione" %>
  </div>

  <div class="campo">
    <%= f.label :dia_vencimento, "Dia de vencimento (apenas para despesas fixas)" %>
    <%= f.number_field :dia_vencimento, min: 1, max: 31 %>
  </div>

  <% if permitir_cartao %>
    <%# Despesa não tem cartao_id como atributo — é repassado solto pro
        CriarDespesa delegar pro CriarCompraNoCartao (ver ticket #9), por
        isso usamos select_tag em vez de f.collection_select. %>
    <div class="campo">
      <label for="despesa_cartao_id">Cartão (apenas se a forma de pagamento for Cartão)</label>
      <%= select_tag "despesa[cartao_id]", options_from_collection_for_select(cartoes, :id, :nome), include_blank: true, id: "despesa_cartao_id" %>
    </div>

    <%# "Parcelada" vale pra qualquer forma de pagamento, não só Cartão —
        com Cartão vira Compra parcelada; sem Cartão vira Parcelamento (ver
        CriarDespesa). Despesa também não tem parcelado/numero_parcelas como
        atributos, mesmo motivo do cartao_id acima. %>
    <div class="campo campo-checkbox">
      <%= hidden_field_tag "despesa[parcelado]", "0", id: nil %>
      <%= check_box_tag "despesa[parcelado]", "1", false, id: "despesa_parcelado" %>
      <label for="despesa_parcelado">Parcelada</label>
    </div>

    <div class="campo">
      <label for="despesa_numero_parcelas">Número de parcelas (se parcelada)</label>
      <%= number_field_tag "despesa[numero_parcelas]", nil, min: 2, id: "despesa_numero_parcelas" %>
    </div>
  <% end %>

  <%= f.submit despesa.persisted? ? "Salvar alterações" : "Registrar despesa" %>
<% end %>
