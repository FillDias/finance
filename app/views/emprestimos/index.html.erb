<% content_for :title, "Empréstimos" %>
<div class="page-header">
  <h1>Empréstimos</h1>
  <%= link_to "Exportar XLSX", exportar_emprestimos_path, class: "botao-secundario" %>
</div>

<section class="formulario-secao">
  <h2>Novo empréstimo</h2>
  <%= render "form", emprestimo: @emprestimo, credores: @credores, erros: @erros %>
</section>

<section>
  <h2>Empréstimos cadastrados</h2>
  <% if @emprestimos.empty? %>
    <p class="vazio">Nenhum empréstimo cadastrado ainda.</p>
  <% else %>
    <table class="tabela-densa">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Credor</th>
          <th>Valor total</th>
          <th>Parcelas</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @emprestimos.each do |emprestimo| %>
          <tr>
            <td><%= link_to emprestimo.nome, emprestimo_path(emprestimo) %></td>
            <td><%= link_to emprestimo.credor.nome, credor_path(emprestimo.credor) %></td>
            <td class="valor"><%= moeda(emprestimo.valor_total) %></td>
            <td><%= emprestimo.parcelas.count %></td>
            <td class="acoes"><%= link_to "Ver parcelas", emprestimo_path(emprestimo) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
