<% content_for :title, @credor.nome %>
<div class="page-header">
  <h1><%= @credor.nome %></h1>
</div>

<section>
  <h2>Cartões</h2>
  <% if @cartoes.empty? %>
    <p class="vazio">Nenhum cartão cadastrado para este credor.</p>
  <% else %>
    <table class="tabela-densa">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Limite</th>
          <th>Fechamento</th>
          <th>Vencimento</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @cartoes.each do |cartao| %>
          <tr>
            <td><%= cartao.nome %></td>
            <td class="valor"><%= moeda(cartao.limite_total) %></td>
            <td>dia <%= cartao.dia_fechamento %></td>
            <td>dia <%= cartao.dia_vencimento %></td>
            <td class="acoes"><%= link_to "Editar", edit_cartao_path(cartao) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section>
  <h2>Empréstimos</h2>
  <% if @emprestimos.empty? %>
    <p class="vazio">Nenhum empréstimo cadastrado para este credor.</p>
  <% else %>
    <table class="tabela-densa">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Valor total</th>
          <th>Parcelas</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @emprestimos.each do |emprestimo| %>
          <tr>
            <td><%= emprestimo.nome %></td>
            <td class="valor"><%= moeda(emprestimo.valor_total) %></td>
            <td><%= emprestimo.parcelas.count %></td>
            <td class="acoes"><%= link_to "Ver parcelas", emprestimo_path(emprestimo) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<%= link_to "Voltar", credores_path, class: "link-voltar" %>
