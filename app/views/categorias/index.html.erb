<% content_for :title, "Categorias" %>
<div class="page-header">
  <h1>Categorias</h1>
  <p class="subtitulo">Compartilhadas entre Despesas e Compras de cartão.</p>
</div>

<section class="formulario-secao">
  <h2>Nova categoria</h2>
  <%= render "form", categoria: @categoria %>
</section>

<section>
  <h2>Categorias cadastradas</h2>
  <% if @categorias.empty? %>
    <p class="vazio">Nenhuma categoria ainda.</p>
  <% else %>
    <table class="tabela-densa">
      <thead>
        <tr>
          <th>Nome</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @categorias.each do |categoria| %>
          <tr>
            <td><%= categoria.nome %></td>
            <td class="acoes">
              <%= link_to "Editar", edit_categoria_path(categoria) %>
              <%= button_to "Excluir", categoria_path(categoria), method: :delete, data: { turbo_confirm: "Remover esta categoria?" }, class: "link-excluir" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<%= link_to "Voltar para Despesas", despesas_path, class: "link-voltar" %>
