<% content_for :title, @cartao.nome %>
<div class="page-header">
  <h1><%= @cartao.nome %></h1>
  <p class="subtitulo">
    <%= link_to @cartao.credor.nome, credor_path(@cartao.credor) %> ·
    Limite <%= moeda(@cartao.limite_total) %> ·
    Fechamento dia <%= @cartao.dia_fechamento %> · Vencimento dia <%= @cartao.dia_vencimento %> ·
    Data de corte <%= @cartao.data_corte.strftime("%d/%m/%Y") %>
  </p>
</div>

<section class="formulario-secao">
  <h2>Lançar saldo herdado</h2>
  <%= form_with model: @novo_saldo_herdado, url: saldos_herdados_path, local: true, class: "formulario" do |f| %>
    <% if @novo_saldo_herdado.errors.any? %>
      <div class="form-erros">
        <ul>
          <% @novo_saldo_herdado.errors.full_messages.each do |mensagem| %>
            <li><%= mensagem %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= f.hidden_field :cartao_id %>

    <div class="campo">
      <%= f.label :mes_referencia, "Mês de referência" %>
      <%= f.date_field :mes_referencia, required: true %>
    </div>

    <div class="campo">
      <%= f.label :valor_total, "Valor total da fatura" %>
      <%= f.number_field :valor_total, step: "0.01", min: "0.01", required: true %>
    </div>

    <%= f.submit "Lançar" %>
  <% end %>

  <p class="ajuda"><%= link_to "Importar planilha de saldo herdado (todos os cartões)", novo_importar_saldo_herdado_path %></p>
</section>

<section>
  <h2>Saldo herdado por mês</h2>
  <% if @saldos_herdados.empty? %>
    <p class="vazio">Nenhum saldo herdado lançado para este cartão.</p>
  <% else %>
    <table class="tabela-densa">
      <thead>
        <tr>
          <th>Mês</th>
          <th>Valor previsto</th>
          <th>Situação</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @saldos_herdados.each do |saldo| %>
          <tr>
            <td><%= saldo.mes_referencia.strftime("%m/%Y") %></td>
            <td class="valor"><%= moeda(saldo.valor_total) %></td>
            <% if saldo.quitado_antecipadamente? %>
              <td>Quitado em <%= saldo.data_pagamento.strftime("%d/%m/%Y") %> (<%= moeda(saldo.valor_pago) %>)</td>
              <td></td>
            <% else %>
              <td>Pendente</td>
              <td class="acoes">
                <%= form_with url: quitar_saldo_herdado_path(saldo), method: :patch, local: true, class: "formulario-inline" do |f| %>
                  <%= f.number_field :valor_pago, step: "0.01", min: "0.01", placeholder: "Valor pago", required: true %>
                  <%= f.date_field :data_pagamento, required: true %>
                  <%= f.submit "Quitar" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="formulario-secao">
  <h2>Lançar compra</h2>
  <%= form_with model: @nova_compra, url: cartao_compras_path(@cartao), local: true, class: "formulario" do |f| %>
    <% if @nova_compra.errors.any? %>
      <div class="form-erros">
        <ul>
          <% @nova_compra.errors.full_messages.each do |mensagem| %>
            <li><%= mensagem %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="campo">
      <%= f.label :data_compra, "Data da compra" %>
      <%= f.date_field :data_compra, required: true %>
    </div>

    <div class="campo">
      <%= f.label :valor_total, "Valor total" %>
      <%= f.number_field :valor_total, step: "0.01", min: "0.01", required: true %>
    </div>

    <div class="campo campo-checkbox">
      <%= f.check_box :parcelado %>
      <%= f.label :parcelado, "Parcelada" %>
    </div>

    <div class="campo">
      <%= f.label :numero_parcelas, "Número de parcelas (se parcelada)" %>
      <%= f.number_field :numero_parcelas, min: 2 %>
    </div>

    <%= f.submit "Lançar compra" %>
  <% end %>
  <p class="ajuda">Compras só podem ser lançadas a partir da data de corte deste cartão (<%= @cartao.data_corte.strftime("%d/%m/%Y") %>).</p>
</section>

<section>
  <h2>Compras e parcelas</h2>
  <% if @compras.empty? %>
    <p class="vazio">Nenhuma compra lançada para este cartão.</p>
  <% else %>
    <% @compras.each do |compra| %>
      <div class="compra-bloco">
        <p class="compra-cabecalho">
          <%= compra.data_compra.strftime("%d/%m/%Y") %> ·
          <%= moeda(compra.valor_total) %> ·
          <%= compra.parcelado? ? "#{compra.numero_parcelas}x" : "à vista" %>
        </p>
        <table class="tabela-densa">
          <thead>
            <tr>
              <th>Vencimento</th>
              <th>Valor</th>
              <th>Situação</th>
            </tr>
          </thead>
          <tbody>
            <% compra.parcelas.order(:data_vencimento).each do |parcela| %>
              <tr>
                <td><%= parcela.data_vencimento.strftime("%m/%Y") %></td>
                <td class="valor"><%= moeda(parcela.valor) %></td>
                <td><%= parcela.status_label %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</section>

<%= link_to "Voltar", cartoes_path, class: "link-voltar" %>
