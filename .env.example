# Copy this file to .env and fill in your real Supabase connection string.
# Never commit .env — it's gitignored.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Used for development and production. The test suite uses a local Postgres
# instance instead (see config/database.yml) and does not read this value.
DATABASE_URL=postgres://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# HTTP Basic Auth in front of the whole app (production only — see ADR
# 0007). Required in production; the app raises on boot-time requests if
# either is missing, rather than silently running unprotected.
HTTP_BASIC_AUTH_USER=choose-a-username
HTTP_BASIC_AUTH_PASSWORD=choose-a-strong-password
